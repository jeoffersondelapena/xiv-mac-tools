#!/bin/sh
# Port + renderer status for the two-window FFXIV setup.
#   xivport            status and orphans
#   xivport clean      also kill orphaned renderers
#   xivport sample     thread-sample every game window (run while the meter is stale, before restarting overlays)
S="$HOME/Library/Application Support/XIV on Mac/wedge-watch/portwatch.py"
case "$1" in
  clean) exec /usr/bin/python3 "$S" --kill-orphans ;;
  sample) exec /usr/bin/python3 "$S" --sample ;;
  sync)  exec /usr/bin/python3 "$S" --sync ;;
  *)     exec /usr/bin/python3 "$S" ;;
esac
